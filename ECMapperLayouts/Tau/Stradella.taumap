<?xml version="1.0" encoding="UTF-8"?>

<layout ecmapperVersion="2.1.0">
  <!-- Stradella: top-to-bottom fifths, starting on Db. MIDI 60 = C4. -->
  <!-- Zone 1: bass. Zone 2: chords. Zone 3: strums linked to Zone 2. -->
  <!-- Column 1: bass, C2-B2 (MIDI 36-47). C is green. -->
